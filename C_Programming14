#include <stdio.h>
int main()
{
    int n, temp, first, last, p = 1, middle, result;
    printf("Enter a number: ");
    scanf("%d", &n);
    last = n % 10;
    temp = n;
loop:
    if (temp >= 10)
    {
        temp = temp / 10;
        p = p * 10;
        goto loop;
    }
    first = temp;
    middle = (n % p) / 10;
    result = last * p + middle * 10 + first;
    printf("After interchange = %d", result);
    return 0;
}
